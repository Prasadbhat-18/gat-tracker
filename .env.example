# =============================================================================
# GAT Tracker - Institutional Administrative Portal Environment Configuration
# =============================================================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/gat_db?retryWrites=true&w=majority"

# NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (for Institutional AI Logic)
GOOGLE_API_KEY="your-google-ai-api-key"

# Google Stitch API Key
STITCH_API_KEY="your-stitch-api-key"

# Node Environment
NODE_ENV="development"
