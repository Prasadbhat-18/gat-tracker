# =============================================================================
# GAT Tracker - Institutional Administrative Portal Environment Configuration
# =============================================================================

# MongoDB Atlas Connection String
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority"

# NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="<generate-random-secret-via-openssl>"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (for Institutional AI Logic)
GOOGLE_API_KEY="<your-google-ai-api-key>"

# Google Stitch API Key
STITCH_API_KEY="<your-stitch-api-key>"

# Node Environment
NODE_ENV="development"
